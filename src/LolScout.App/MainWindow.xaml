<Window x:Class="LolScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="联盟一区对手战绩助手" Width="1040" Height="610" MinWidth="820" MinHeight="500"
        Topmost="{Binding IsTopmost}">
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
               Foreground="#70809D" FontSize="11"
               Text="本工具非 Riot 官方产品、未获 Riot 背书且不代表 Riot 观点；Riot 及相关商标归其所有。LCU 为不受支持的私有接口，更新可能导致失效。" />
    <Border DockPanel.Dock="Top" Background="#172033" CornerRadius="8" Padding="16" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="运行状态：" Foreground="#AFC4E8" FontSize="16" />
        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
        <TextBlock Text="  ·  " Foreground="#70809D" />
        <TextBlock Text="{Binding OperationStatus}" Foreground="#AFC4E8" FontSize="14" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding ManualPlayerIds, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="42" Padding="10,8" VerticalContentAlignment="Center"
                 ToolTip="粘贴游戏名#标签，多个 ID 用逗号或换行分隔" />
        <Button Grid.Column="1" Content="手动查询" Command="{Binding QueryManualCommand}"
                Padding="18,9" Margin="10,0,0,0" />
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
      <Button Content="复制精简播报" Command="{Binding CopyBroadcastCommand}" Padding="18,9" Margin="5" />
      <Button Content="重新查询" Command="{Binding RefreshCommand}" Padding="18,9" Margin="5" />
      <Button Content="保持置顶" Command="{Binding ToggleTopmostCommand}" Padding="18,9" Margin="5" />
      <Button Content="查看查询状态" Command="{Binding ShowStatusCommand}" Padding="18,9" Margin="5" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Players}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="5" Padding="14" Background="#F8FAFC">
            <StackPanel>
              <TextBlock Text="{Binding PlayerName}" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ChampionName}" Foreground="#3B5CCC" Margin="0,4,0,10" />
              <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Text="{Binding Overall}" TextWrapping="Wrap" Margin="0,3" />
              <TextBlock Text="{Binding Mvp}" TextWrapping="Wrap" Margin="0,3" />
              <TextBlock Text="{Binding Position}" TextWrapping="Wrap" Margin="0,3" />
              <TextBlock Text="{Binding ChampionPerformance}" TextWrapping="Wrap" Margin="0,3" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</Window>
